# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Clerk keys (Dashboard -> API Keys). Both are required for verifying
# session tokens on protected/admin routes - do NOT commit real values.
# Use the same publishable key as the frontend's VITE_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key

# Secret used to sign vote receipts (see votingController.generateReceipt).
# Any long random string - generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, falls back to CLERK_SECRET_KEY, but a dedicated secret is safer
# to rotate independently.
RECEIPT_SECRET=change-me-to-a-long-random-string

# --- Voter registry / OTP (simulated college voter authentication) ---
# Secret used to HMAC-hash Aadhaar numbers before storage - raw Aadhaar is
# never stored. Falls back to RECEIPT_SECRET/CLERK_SECRET_KEY if unset, but
# a dedicated secret is safer to rotate independently. Generate the same
# way as RECEIPT_SECRET above.
AADHAAR_HASH_SECRET=change-me-to-a-long-random-string

# Secret used to hash OTP codes before storage. Same fallback chain.
OTP_HASH_SECRET=change-me-to-a-long-random-string

# OTP delivery provider. "mock" (default) logs the OTP to the SERVER
# console only, for local dev/demo - never exposed to the frontend. Set to
# "twilio" (and implement/add credentials) for real SMS delivery - see
# utils/otpProvider.js.
OTP_PROVIDER=mock

# Port the Express server listens on
PORT=5000

# --- Email (result publication emails) - see services/emailService.js ---
# "console" (default) logs emails to the SERVER console only - nothing is
# actually sent; safe for local dev/demo. "smtp" sends through any SMTP
# server or transactional provider's SMTP relay (Gmail app password,
# SendGrid, Mailgun, Amazon SES, Brevo, ...). "disabled" makes every send
# fail (useful for testing the failed-delivery / retry path).
# Credentials are server-side only - never put them in the frontend .env.
EMAIL_PROVIDER=console
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# Optional: "true" forces implicit TLS (default: true only for port 465)
EMAIL_SECURE=
EMAIL_USER=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_FROM="Smart Voting System <no-reply@example.com>"

# Public URL of the frontend, used for the "view the complete results" link
# in result emails (optional).
FRONTEND_URL=https://e-vote-flax.vercel.app

# Time zone used when formatting election dates in emails.
APP_TIMEZONE=Asia/Kolkata

# --- Election reminder notifications ---
# How often the in-process scheduler checks for due reminders (ms).
# Set to 0 to disable the scheduler (e.g. when running several instances
# and only one should send reminders - duplicates are prevented either way).
NOTIFICATION_INTERVAL_MS=60000

# --- Chatbot (Smart Voting Assistant) ---
# "rules" (default) = built-in rule-based answers, no external service.
# "anthropic" = Claude answers (same privacy-filtered context), falling back
# to rules on any error. Requires ANTHROPIC_API_KEY - server-side only,
# never put it in the frontend .env.
CHATBOT_PROVIDER=rules
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
CHATBOT_MODEL=
# Max chatbot questions per user per minute.
CHATBOT_RATE_LIMIT_PER_MIN=20
